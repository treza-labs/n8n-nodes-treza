              "id": "5ad67cd8-57bd-5b1e-8ce8-be7ad1426440",
              "name": "aspectRatio",
              "type": "string",
              "value": "9:16"
            },
            {
              "id": "1985eddf-d1ac-56ef-bfd6-afef8c4a10b4",
              "name": "seconds",
              "type": "number",
              "value": 4
            },
            {
              "id": "d6b8db48-2c61-55df-a982-81694b36fdf6",
              "name": "maxCostUsd",
              "type": "number",
              "value": 1
            },
            {
              "id": "44b0f687-caaa-5f24-b7a0-ca0b42eab213",
