              "type": "number",
              "value": 10
            },
            {
              "id": "d0bfb1ef-c941-5341-afe1-e30d9f53d683",
              "name": "style",
              "type": "string",
              "value": "Clean studio set, soft key light, premium ad look."
            }
          ]
        },
        "options": {},
        "includeOtherFields": true
      }
    },
    {
      "id": "44f1a284-91b1-5901-956f-6e357ae61acc",
      "name": "Has a photo?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "14c9c731-8330-5d1d-898d-b56909e3017c",
              "leftValue": "={{ ($json.images && $json.images[0] && $json.images[0].src) || ($json.image && $json.image.src) || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "449fe40e-acbb-5278-ba5d-b771cdb0201d",
      "name": "Bring the photo into Treza",
      "type": "@treza/n8n-nodes-treza.treza",
      "typeVersion": 1,
      "position": [
        660,
        100
      ],
      "parameters": {
        "resource": "media",
        "operation": "importFromUrl",
        "sourceUrl": "={{ ($json.images && $json.images[0] && $json.images[0].src) || ($json.image && $json.image.src) || '' }}"
      }
    },
    {
      "id": "85b6c4f7-51cb-559a-8632-0239304c3d30",
      "name": "Write the motion",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        880,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Product: {{ $('Settings').item.json.title }}\nDescription: {{ ($('Settings').item.json.body_html || '').replace(/<[^>]+>/g, ' ').slice(0, 600) }}\nStyle: {{ $('Settings').item.json.style }}",
        "messages": {
          "messageValues": [
            {
              "message": "You write the prompt for an AI video model that animates a product photo. The clip opens on the photo.\nWrite one prompt of 30 to 50 words: one slow, simple camera move or product motion, the setting and the light, in the given style. End with: Keep the product, its label and its colors exactly as they are.\nNo on-screen text, no people, no prices, no logos added. Reply with the prompt only."
            }
          ]
        },
        "batching": {}
      }
    },
    {
      "id": "9c875f11-6734-5f13-a229-2a659ed77b26",
      "name": "Chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        860,
        340
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "options": {}
      }
    },
    {
      "id": "7da743f9-7c28-5e51-ac96-5765094c3841",
      "name": "Make the product video",
      "type": "@treza/n8n-nodes-treza.treza",
      "typeVersion": 1,
      "position": [
        1140,
        100
      ],
      "parameters": {
        "resource": "video",
        "operation": "generate",
        "prompt": "={{ $json.text }}",
        "aspectRatio": "={{ $('Settings').item.json.aspectRatio }}",
        "durationSec": "={{ $('Settings').item.json.seconds }}",
        "maxCostUsd": "={{ $('Settings').item.json.maxCostUsd }}",
        "additionalFields": {
          "firstFrameUrl": "={{ $('Bring the photo into Treza').item.json.url }}",
          "name": "={{ $('Settings').item.json.title }}"
        },
        "timeoutMinutes": "={{ $('Settings').item.json.waitMinutes }}"
      }
    },
    {
      "id": "962ddea0-ea97-535d-bd0d-a5be2824f8ec",
      "name": "Still rendering?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1360,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "310e36d3-049d-50dc-9d98-8e5734548841",
              "leftValue": "={{ $json.timedOut === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ebf242c7-2452-5def-ae8a-d894d13c35f9",
      "name": "Wait for the render",
      "type": "@treza/n8n-nodes-treza.treza",
      "typeVersion": 1,
      "position": [
        1360,
        340
      ],
      "parameters": {
        "resource": "run",
        "operation": "wait",
        "pipelineId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.pipelineId }}"
        },
        "runId": "={{ $json.runId }}",
        "timeoutMinutes": 30
      }
    },
    {
      "id": "d8bbee07-afe2-5160-a2d0-2a99d207d69b",
      "name": "Did it render?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1560,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "56ae7877-fbb8-58af-9e55-a746ca516a59",
              "leftValue": "={{ !!$json.url }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e7cd7083-baf6-5eaf-8db1-f0583038d792",
      "name": "Send it for review",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1800,
        100
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "text": "=New product video for *{{ $('Settings').item.json.title }}*: {{ $json.url }}",
        "otherOptions": {}
      },
      "webhookId": "248061df-1751-5cc1-b950-826728518935"
    },
    {
      "id": "25b36605-181d-51df-97a3-8c73cf383952",
      "name": "Say why it stopped",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1800,
        340
