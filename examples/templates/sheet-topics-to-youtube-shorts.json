    {
      "id": "cd2cc184-a06e-51a5-a399-f2dd48e31c29",
      "name": "Write the shot and caption",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        920,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Topic: {{ $('Settings').item.json.topic }}\nVoice: {{ $('Settings').item.json.voice }}\nClip length: {{ $('Settings').item.json.seconds }} seconds, shape {{ $('Settings').item.json.aspectRatio }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You plan one short vertical video for social media.\nFrom the topic, write:\n- shot: one continuous shot for an AI video model, 40 to 70 words. Say the subject, the action, the setting, the light and the camera move. No on-screen text, no logos, no real people or brands.\n- title: a YouTube title under 70 characters.\n- caption: a description of one or two sentences in the given voice."
            }
          ]
        },
        "batching": {}
      }
